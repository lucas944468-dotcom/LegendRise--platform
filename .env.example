# Copy to .env (NEVER commit .env). Founder fills the manual values.
# See IMPLEMENTATION_PLAN.md → Founder-action checklist.

# --- Database (local PostgreSQL, founder installs) ---
DATABASE_URL="postgresql://legendrise:CHANGEME@localhost:5432/legendrise"

# --- Better Auth ---
BETTER_AUTH_SECRET="GENERATE_WITH: openssl rand -base64 32"
BETTER_AUTH_URL="http://localhost:5173"
PUBLIC_APP_URL="http://localhost:5173"

# --- Cloudflare R2 (founder: account + bucket + API token) ---
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="legendrise"
R2_PUBLIC_URL="https://pub-XXXX.r2.dev"

# --- Resend (auth emails: verification + password reset) ---
# Paste your key into .env as RESEND_API_KEY="re_..." (NEVER commit .env).
# Testing without your own domain: leave EMAIL_FROM unset. Resend then sends
# from onboarding@resend.dev and delivers ONLY to your Resend account email.
# Production: verify your domain at resend.com/domains, then set e.g.
# EMAIL_FROM="LegendRise <noreply@yourdomain.com>".
RESEND_API_KEY=""
EMAIL_FROM=""

# --- AI (Phase 6; server-side only) ---
# Groq is the primary provider (OpenAI-compatible). Set GROQ_API_KEY to enable
# real AI coaching/assessment; otherwise deterministic v0 fallbacks are used.
# Get a key at https://console.groq.com/keys (never commit .env).
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
# Optional fallback provider:
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
