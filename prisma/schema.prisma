// LegendRise data model — PRD §15 + Appendices A–C.
// Auth tables (User/Session/Account/Verification) are owned by Better Auth;
// every user-owned app table carries userId for app-level scoping (no RLS).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Better Auth core (do not rename fields) ----------

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  isAdmin       Boolean   @default(false) // role gate for /admin (Phase 8)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  sessions Session[]
  accounts Account[]

  profile          Profile?
  submissions      Submission[]
  evidence         Evidence[]
  progress         Progress[]
  ventureProjects  VentureProject[]
  aiConversations  AiConversation[]
  subscription     Subscription?

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("verification")
}

// ---------- Product enums ----------

enum GoalType {
  CAREER
  VENTURE
}

enum MilestoneStatus {
  LOCKED
  IN_PROGRESS
  COMPLETED
  NEEDS_ATTENTION
}

enum CapabilityStatus {
  NOT_ASSESSED
  DEVELOPING
  DEMONSTRATED
  NEEDS_REVIEW
}

enum EvidenceType {
  PROJECT
  SIMULATION
  ASSESSMENT
  CERTIFICATE
  VALIDATION_FINDING
  BUSINESS_MODEL
  FINANCIAL_MODEL
  PILOT_RESULT
  OTHER
}

// ---------- PRD §15 tables ----------

model Profile {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  goalType    GoalType
  targetRole  String?
  currentLevel String?
  experience  String?
  preferences Json?
  availabilityHoursPerWeek Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model CareerPath {
  id          String   @id @default(cuid())
  name        String   @unique
  description String
  levels      Json // ordered level definitions (Appendix A)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  milestones Milestone[]
}

model Milestone {
  id           String          @id @default(cuid())
  careerPathId String
  careerPath   CareerPath      @relation(fields: [careerPathId], references: [id], onDelete: Cascade)
  order        Int
  level        String
  title        String
  objectives   Json?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  lessons     Lesson[]
  simulations Simulation[]
  assessments Assessment[]
  progress    Progress[]

  @@unique([careerPathId, order])
}

model Lesson {
  id          String    @id @default(cuid())
  milestoneId String
  milestone   Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  title       String
  text        String?   @db.Text
  mediaUrl    String? // R2 key/URL
  resources   Json? // linked resource descriptors (§10)
  version     Int       @default(1)
  isPublished Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Simulation {
  id          String    @id @default(cuid())
  milestoneId String
  milestone   Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  scenario    Json // Appendix B spec
  rubricId    String?
  isPublished Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Assessment {
  id          String    @id @default(cuid())
  milestoneId String
  milestone   Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  task        String    @db.Text
  rubric      Json // Appendix C spec (criteria, levels, scoring)
  passRule    Json?
  isPublished Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  submissions Submission[]
}

model Submission {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  content      String     @db.Text
  score        Json?
  feedback     String?    @db.Text
  version      Int        @default(1)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([userId, assessmentId])
}

model Evidence {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      EvidenceType
  title     String
  source    String? // origin of the evidence (§8.1 / §12)
  fileKey   String? // R2 key for attachments
  status    CapabilityStatus @default(NOT_ASSESSED)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([userId, status])
}

model Progress {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestoneId String
  milestone   Milestone       @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  status      MilestoneStatus @default(LOCKED)
  score       Float?
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([userId, milestoneId])
}

// Venture pathway (Phase 11; architecture only in MVP — FR-018)
model VentureProject {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stage     String // §8 stages: goal → problem → … → pilot
  status    String   @default("DRAFT")
  brief     Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  evidence VentureEvidence[]
}

model VentureEvidence {
  id        String         @id @default(cuid())
  projectId String
  project   VentureProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type      String // assumption vs evidence (§8.1)
  source    String?
  result    Json?
  createdAt DateTime       @default(now())
}

model AiConversation {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contextType String // lesson | simulation | coach | assessment | venture
  contextId   String?
  messages    Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, contextType])
}

model Subscription {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan              String   @default("FREE")
  status            String   @default("INACTIVE")
  providerReference String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
